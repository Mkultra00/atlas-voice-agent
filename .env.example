# Copy to .env.local, or run: lk app env --write --destination .env.local
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which agent answers: booking | screener | mine | safety
AGENT_PROFILE=booking
# Which models: budget | quality | safety   (see src/models.py)
MODEL_PRESET=budget
# Must match "agent_name" in dispatch-rule.json
AGENT_NAME=take2-agent

# ---- Atlas (AGENT_PROFILE=safety) -------------------------------------------
# ElevenLabs key for the `safety` preset. Unset -> Cartesia only (logs
# elevenlabs_disabled). Never commit a real key.
ELEVEN_API_KEY=
# ElevenLabs voice id. Empty -> premade "George" (JBFqnCBsd6RMkjVDRZzb).
ELEVEN_VOICE_ID=
# 1 = send enable_logging=False (zero retention, if your ElevenLabs plan allows it)
ELEVEN_ZERO_RETENTION=
# Ops desk incoming webhook (Slack, Discord or any JSON endpoint). Unset ->
# honest log-only mode: alerts go to ops_log.jsonl and Atlas never says
# "a person has been alerted".
ATLAS_OPS_WEBHOOK=
# slack | discord | json. Empty -> detected from the URL (json otherwise)
OPS_WEBHOOK_FORMAT=
# 1 = include the caller's raw phone number in ops alerts as a callback
OPS_INCLUDE_CALLBACK=
# Caller number (E.164) to assume when there is no SIP participant, e.g. in
# the debugger or console, e.g. +15550102030 (the fake profile in data/travelers.json).
ATLAS_DEMO_CALLER=
# Tavily news search key. Unset -> "I couldn't find any reports about that."
TAVILY_API_KEY=
# 1 = speak the placeholder demo_data news in data/demo_cache.json when live
# news fails. Demo only: those entries are written for the demo, not real.
ATLAS_DEMO_NEWS=
# Contact (team URL or address) for the Nominatim User-Agent policy
NOMINATIM_CONTACT=
# Optional endpoint overrides (defaults in src/safety_tools.py)
OSRM_FOOT_URL=
OSRM_CAR_URL=
OVERPASS_URL=
NOMINATIM_URL=
# 1 = full LiveKit recording (audio, transcript, traces). Debug only.
ATLAS_RECORD=
# Close the line after this many silent minutes once a person was alerted
ATLAS_MAX_SILENT_MINUTES=30
